# Production PostgreSQL connection. Use Supabase/Vercel/Render/Railway secrets for real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Direct PostgreSQL connection for Prisma migrations. Supabase projects usually need this
# in addition to DATABASE_URL when DATABASE_URL points at a pooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Required in every deployed environment. Generate a long random value and keep it secret.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Business-day reporting and history filters use this timezone.
BUSINESS_TIMEZONE="Asia/Kolkata"

# Local SQLite development only:
# DATABASE_URL="file:./dev.db"

# Local/demo seed passwords only. Set strong temporary values before seeding production.
SEED_ADMIN_PASSWORD="replace-before-seeding"
SEED_STAFF_PASSWORD="replace-before-seeding"
